<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  <thead>
    <tr>
      <th class="<%= sort_class("title") %>"><%= sortable "title", "Title" %></th>
      <th class="<%= sort_class("rating") %>"><%= sortable "rating", "Rating" %></th>
      <th class="<%= sort_class("release_date") %>"><%= sortable "release_date", "Release Date" %></th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td>
        <%= link_to "New movie", new_movie_path %>
      </td>
    </tr>
  </tfoot>
</table>

